<!DOCTYPE html>
<html lang="zxx">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="Senyetna Template">
    <meta name="keywords" content="Senyetna, unica, creative, html">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Senyetna | Accueil</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400;600;900&display=swap" rel="stylesheet">

    <!-- Css Styles -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="{{ asset('css/elegant-icons.css') }}" type="text/css">
    <link rel="stylesheet" href="{{ asset('css/nice-select.css') }}" type="text/css">
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="{{ asset('css/owl.carousel.min.css') }}" type="text/css">
    <link rel="stylesheet" href="{{ asset('css/slicknav.min.css') }}" type="text/css">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}" type="text/css">
</head>

<body>
<!-- Header Section Begin -->
<header class="header">
    <div class="header__top">
        <div class="container">
            <div class="row">
                <div class="col-lg-6">
                    <div class="header__top__left">
                        <ul>
                            <li><i class="fa fa-envelope"></i> contact@senyetna.local</li>
                            <li>Projet académique Symfony</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="header__top__right">
                        <div class="header__top__right__social">
                            <a href="#"><i class="fa fa-facebook"></i></a>
                            <a href="#"><i class="fa fa-twitter"></i></a>
                            <a href="#"><i class="fa fa-linkedin"></i></a>
                            <a href="#"><i class="fa fa-pinterest-p"></i></a>
                        </div>
                        <div class="header__top__right__language">
                            <img src="{{ asset('img/language.png') }}" alt="" style="display:none;">
                            <div>English</div>
                            <span class="arrow_carrot-down"></span>
                            <ul>
                                <li><a href="#">Spanish</a></li>
                                <li><a href="#">English</a></li>
                            </ul>
                        </div>
                        <div class="header__top__right__auth">
                            {% if app.user %}
                                <a href="{{ path('app_logout') }}"><i class="fa fa-user"></i> {{ app.user.nom }} — Déconnexion</a>
                            {% else %}
                                <a href="{{ path('app_login') }}"><i class="fa fa-user"></i> Connexion</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="header__logo">
                    <a href="{{ path('app_index') }}" style="font-size:1.6rem;font-weight:800;color:#7fad39;">Senyetna</a>
                </div>
            </div>
            <div class="col-lg-6">
                <nav class="header__menu">
                    <ul>
                        <li class="active"><a href="{{ path('app_index') }}">Accueil</a></li>
                        <li><a href="{{ path('shop_grid') }}">Boutique</a></li>
                        <li><a href="#">Pages</a>
                            <ul class="header__menu__dropdown">
                                <li><a href="{{ path('app_shop_details') }}">Détail boutique</a></li>
                                <li><a href="{{ path('app_shoping_cart') }}">Panier</a></li>
                                <li><a href="{{ path('app_checkout') }}">Commande</a></li>
                                <li><a href="{{ path('app_blog_deatils') }}">Article</a></li>
                            </ul>
                        </li>
                        <li><a href="{{ path('app_blog') }}">Blog</a></li>
                        <li><a href="{{ path('app_contact') }}">Contact</a></li>
                    </ul>
                </nav>
            </div>
            <div class="col-lg-3">
                <div class="header__cart">
                    <ul>
                        <li><a href="#"><i class="fa fa-heart"></i> <span>1</span></a></li>
                        <li><a href="#"><i class="fa fa-shopping-bag"></i> <span>3</span></a></li>
                    </ul>
                    <div class="header__cart__price">item: <span>$150.00</span></div>
                </div>
            </div>
        </div>
        <div class="humberger__open">
            <i class="fa fa-bars"></i>
        </div>
    </div>
</header>
<!-- Header Section End -->
<!-- Humberger Begin -->
<div class="humberger__menu__overlay"></div>
<div class="humberger__menu__wrapper">
    <div class="humberger__menu__logo">
        <a href="{{ path('app_index') }}" style="font-weight:800;color:#7fad39;">Senyetna</a>
    </div>
    <div class="humberger__menu__cart">
        <ul>
            <li><a href="#"><i class="fa fa-heart"></i> <span>1</span></a></li>
            <li><a href="#"><i class="fa fa-shopping-bag"></i> <span>3</span></a></li>
        </ul>
        <div class="header__cart__price">item: <span>$150.00</span></div>
    </div>
    <div class="humberger__menu__widget">
        <div class="header__top__right__language">
            <img src="{{ asset('img/language.png') }}" alt="" style="display:none;">
            <div>English</div>
            <span class="arrow_carrot-down"></span>
            <ul>
                <li><a href="#">Spanish</a></li>
                <li><a href="#">English</a></li>
            </ul>
        </div>
        <div class="header__top__right__auth">
            {% if app.user %}
                <a href="{{ path('app_logout') }}"><i class="fa fa-user"></i> Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}"><i class="fa fa-user"></i> Connexion</a>
            {% endif %}
        </div>
    </div>
    <nav class="humberger__menu__nav mobile-menu">
        <ul>
            <li class="active"><a href="{{ path('app_index') }}">Accueil</a></li>
            <li><a href="{{ path('shop_grid') }}">Shop</a></li>
            <li><a href="#">Pages</a>
                <ul class="header__menu__dropdown">
                    <li><a href="{{ path('app_shop_details') }}">Shop Details</a></li>
                    <li><a href="{{ path('app_shoping_cart') }}">Shopping Cart</a></li>
                    <li><a href="{{ path('app_checkout') }}">Check Out</a></li>
                    <li><a href="{{ path('app_blog_deatils') }}">Blog Details</a></li>
                </ul>
            </li>
            <li><a href="{{ path('app_blog') }}">Blog</a></li>
            <li><a href="{{ path('app_contact') }}">Contact</a></li>
        </ul>
    </nav>
</div>
<!-- Humberger End -->


<!-- Hero Section Begin -->
<section class="hero">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="hero__categories">
                    <div class="hero__categories__all">
                        <i class="fa fa-bars"></i>
                        <span>All departments</span>
                    </div>
                    <ul>
                        <li><a href="#">Fresh Meat</a></li>
                        <li><a href="#">Vegetables</a></li>
                        <li><a href="#">Fruit & Nut Gifts</a></li>
                        <li><a href="#">Fresh Berries</a></li>
                        <li><a href="#">Ocean Foods</a></li>
                        <li><a href="#">Butter & Eggs</a></li>
                        <li><a href="#">Fastfood</a></li>
                        <li><a href="#">Fresh Onion</a></li>
                        <li><a href="#">Papayaya & Crisps</a></li>
                        <li><a href="#">Oatmeal</a></li>
                        <li><a href="#">Fresh Bananas</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="hero__item set-bg" data-setbg="https://placehold.co/840x430/7fad39/ffffff?text=Senyetna">
                    <div class="hero__text">
                        <span>FRUITS & LÉGUMES</span>
                        <h2>Produits frais<br />100 % nature</h2>
                        <p>Boutique en ligne — projet Symfony 6</p>
                        <a href="{{ path('shop_grid') }}" class="primary-btn">Voir la boutique</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->

<!-- Categories Section Begin -->
<section class="categories">
    <div class="container">
        <div class="row">
            {% for produit in produits %}
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card shadow-sm" style="width: 250px; height: 300px; background-color: #f8f9fa; margin: 0 auto;">
                        <!-- Image en haut de la carte -->
                        <div class="card-img-top" 
                            style="background-image: url('{{ produit.image ? asset('uploads/' ~ produit.image) : 'https://placehold.co/250x110?text=' ~ produit.nomProduit|url_encode }}'); 
                                    height: 110px; 
                                    background-size: cover; 
                                    background-position: center; 
                                    background-color: #dcdcdc;">
                        </div>
                        <!-- Contenu de la carte -->
                        <div class="card-header text-center" style="background-color: #ffffff; color: #343a40;">
                            <h5 class="mb-0">{{ produit.nomProduit }}</h5>
                        </div>
                        <div class="card-body" style="overflow: auto; margin:0; padding-top : 0;padding-Bottom : 0;">
                            <p style="margin: 0"><strong>ID Produit :</strong> {{ produit.idProduit }}</p>
                            <p style="margin: 0"><strong>Prix :</strong> {{ produit.prix }} €</p>
                            <p style="margin: 0"><strong>Catégorie :</strong> {{ produit.categorie }}</p>
                        </div>
                        <div class="card-footer text-center">
                            <a href="{{ path('app_produit_show', {'id': produit.id}) }}" class="btn btn-outline-primary btn-sm">Voir</a>
                            {% if app.user %}
                                <a href="{{ path('app_produit_edit', {'id': produit.id}) }}" class="btn btn-outline-secondary btn-sm">Modifier</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-warning text-center" role="alert">
                        Aucun produit trouvé.
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="text-center mt-4">
            <a href="{{ path('app_produit_new') }}" class="btn btn-success">Créer un nouveau produit</a>
        </div>
    </div>
</section>
<BR />  
<!-- Categories Section End -->
<!-- Categories Section Begin -->
<section class="categories">
    <div class="container">
        <div class="row">
            <div class="categories__slider owl-carousel">
                {% for category in categories %}
                    <div class="col-lg-3">
                        <div class="categories__item set-bg" data-setbg="{{ category.image }}">
                            <h5><a href="{{ category.link }}">{{ category.name }}</a></h5>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
<!-- Categories Section End -->

<!-- Featured Section Begin -->
<section class="featured spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>Nos produits</h2>
                </div>
                <div class="featured__controls">
                    <ul>
                        <li class="active" data-filter="*">Tous</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="row featured__filter">
            {% for produit in produits %}
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="featured__item">
                        <div class="featured__item__pic set-bg" data-setbg="{{ produit.image ? asset('uploads/' ~ produit.image) : 'https://placehold.co/270x270?text=' ~ produit.nomProduit|url_encode }}">
                            <ul class="featured__item__pic__hover">
                                <li><a href="{{ path('app_produit_show', {id: produit.id}) }}"><i class="fa fa-shopping-cart"></i></a></li>
                            </ul>
                        </div>
                        <div class="featured__item__text">
                            <h6><a href="{{ path('app_produit_show', {id: produit.id}) }}">{{ produit.nomProduit }}</a></h6>
                            <h5>{{ produit.prix }} €</h5>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center">
                    <p>Aucun produit pour le moment. <a href="{{ path('app_produit_new') }}">Ajouter un produit</a></p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
<!-- Featured Section End -->

<!-- Footer Section Begin -->
<footer class="footer spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="footer__about">
                    <h4 style="color:#7fad39;font-weight:800;">Senyetna</h4>
                    <ul>
                        <li>Boutique en ligne — projet académique Symfony 6</li>
                        <li><a href="{{ path('app_contact') }}">Contact</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="footer__widget">
                    <h6>Navigation</h6>
                    <ul>
                        <li><a href="{{ path('app_index') }}">Accueil</a></li>
                        <li><a href="{{ path('shop_grid') }}">Boutique</a></li>
                        <li><a href="{{ path('app_blog') }}">Blog</a></li>
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</footer>
<!-- Footer Section End -->

<!-- Js Plugins -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('js/jquery.nice-select.min.js') }}"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<script src="{{ asset('js/jquery.slicknav.js') }}"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
<script src="{{ asset('js/main.js') }}"></script>
</body>
</html>
